# Reemplazá estos valores y guardá la copia como .env en el servidor. Nunca publiques ese archivo.
APP_DOMAIN=veterinaria.ejemplo.com
DJANGO_SECRET_KEY=generar-una-clave-larga-y-privada
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.tu-proveedor.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_HOST_USER=usuario-smtp
DJANGO_EMAIL_HOST_PASSWORD=contraseña-o-api-key-smtp
DJANGO_DEFAULT_FROM_EMAIL=Tu Veterinaria <no-reply@tudominio.com>

{
  "expo": {
    "name": "Tu Veterinaria Comunidad",
    "slug": "tu-veterinaria-comunidad",
    "version": "0.1.0",
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tu Veterinaria usa tu ubicación solo cuando elegís compartir el lugar de un avistamiento."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Tu Veterinaria usa la cámara solo para adjuntar una foto a un aviso o avistamiento.",
          "photosPermission": "Tu Veterinaria necesita acceso a tus fotos solo cuando elegís adjuntar una imagen."
        }
      ],
      "expo-notifications"
    ],
    "android": {
      "package": "com.vasco88.tuveterinariacomunidad",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "fffa2d9a-495a-4715-94ef-c124f5721bf5"
      }
    },
    "owner": "vasco_88"
  }
}

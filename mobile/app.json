{
  "expo": {
    "name": "Lazuna",
    "slug": "tu-veterinaria-comunidad",
    "version": "0.8.30",
    "icon": "./assets/icon.png",
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lazuna usa tu ubicación cuando elegís buscar animales cercanos o compartir la zona de un avistamiento."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lazuna usa la cámara solo cuando elegís adjuntar una foto.",
          "photosPermission": "Lazuna accede a tus fotos solo cuando elegís adjuntar una imagen."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0b6355"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lazuna usa la biometría solo para desbloquear tu sesión guardada en este teléfono."
        }
      ]
    ],
    "android": {
      "package": "com.vasco88.tuveterinariacomunidad",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f7faf8"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "fffa2d9a-495a-4715-94ef-c124f5721bf5"
      }
    },
    "owner": "vasco_88"
  }
}
